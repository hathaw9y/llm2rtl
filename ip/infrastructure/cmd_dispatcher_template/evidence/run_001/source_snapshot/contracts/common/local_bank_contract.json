{
  "schema": "llm2rtl.common_contract.v1",
  "contract_id": "local_bank",
  "version": 1,
  "bank_id_semantics": "validated_logical_local_tensor_handle",
  "descriptor_required_fields": [
    "bank_id",
    "capacity_words",
    "word_bits",
    "format",
    "layout",
    "valid",
    "busy",
    "owner"
  ],
  "ownership_mode": "single_exclusive_lock_per_bank",
  "states": ["free", "acquired", "fault"],
  "ownership_rules": [
    "read_and_write_ownership_are_not_distinguished",
    "every_dma_or_compute_operand_bank_must_be_free_before_command_acceptance",
    "all_operand_banks_are_acquired_atomically_on_command_acceptance",
    "each_acquired_bank_has_exactly_one_owner_opcode",
    "banks_are_released_only_by_the_matching_command_completion_or_reset",
    "active_bank_cannot_be_overwritten",
    "command_bram_is_separate_from_data_banks",
    "data_bank_zero_is_legal"
  ],
  "router_rule": "router_resolves_bank_id_to_physical_base_extent_format_and_state",
  "compute_address_rule": "compute_never_receives_raw_local_address_or_offset"
}
