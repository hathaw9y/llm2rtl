  "profile_rules": {
    "weight_INT8": {
      "data_shape": "[N_tile,K]",
      "row_stride_bytes": "align(K,16)",
      "scale_shape": "[ceil(N_tile/16)]",
      "scale_index": "floor(local_output_channel/16)",
      "max_scale_bytes": 48
    },
    "embedding_rows_INT8": {
      "data_shape": "[rows,576]",
      "row_stride_bytes": 576,
      "scale_shape": "[rows,4] FP32 blocks",
      "scale_index": "row*4+descriptor.embedding_scale_lane[row]",
      "max_scale_bytes": 512,
      "scale_row_stride_bytes": 16,
      "lane_selector_storage": "two-bit descriptor field per row, written by validated DMA aux; not CPU tensor processing"
    },
    "A_INT8": {
      "data_shape": "[rows,K]",
      "row_stride_bytes": "align(K,16)",
      "scale_shape": "[ceil(rows/16)]",
      "scale_index": "floor(row/16)",
      "max_scale_bytes": 8
    },
    "Q_INT8": {
      "data_shape": "[rows,9,64]",
      "row_stride_bytes": 576,
      "scale_shape": "[9,ceil(rows/16)]",
      "scale_index": "head*ceil(rows/16)+floor(row/16)",
      "max_scale_bytes": 72
    },
    "K_current_or_cache_INT8": {
      "data_shape": "[tokens,3,64]",
      "row_stride_bytes": 192,
      "scale_shape": [
        3
      ],
      "scale_index": "KV_head",
      "max_scale_bytes": 12
    },
    "V_current_or_cache_INT8": {
      "data_shape": "[tokens,3,64]",
      "row_stride_bytes": 192,
      "scale_shape": [
        3,
        4
      ],
      "scale_index": "KV_head*4+floor(feature/16)",
      "max_scale_bytes": 48
    },
    "probability_INT8": {
      "data_shape": "[rows,9,S_pad]",
      "row_stride_bytes": "9*align(valid_context,16)",
      "scale_shape": "[9,ceil(rows/16)]",
      "scale_index": "head*ceil(rows/16)+floor(row/16)",
      "max_scale_bytes": 72
    },
    "score_probability_BF16": {
      "data_shape": "[rows,9,S_pad]",
      "S_pad": "align(valid_context,16)",
      "row_stride_bytes": "18*align(valid_context,16)"
    },
    "static_KV_scales": {
      "data_shape": [
        30,
        64
      ],
      "entry_stride_bytes": 64,
      "K_scale_byte_offset": "4096 + layer*64 + head*4",
      "V_scale_byte_offset": "4096 + layer*64 + 16 + (head*4+floor(feature/16))*4",
      "padding": "entry bytes 12..15 zero; entries contain 3 K FP32 scales and 12 V FP32 scales",
      "bank": 7,
      "bank_table_byte_offset": 4096
    }
  },
  "physical_memory": {
    "all_write_bits": 128,
    "INT8_lanes_per_write": 16,
    "GEMM_source_read_bits": 256,
    "INT8_lanes_per_wide_read": 32,
    "wide_alignment_bytes": 32,
    "DMA_stream_bits": 128,
    "DMA_alignment_bytes": 16,
    "native_address_unit": "128-bit words; wide request uses an even word address",
    "read_latency_cycles": 3,
    "read_response": "resp_valid for every accepted read; explicit response owner association",
    "wide_read_banks": [
      3,
      13,
      14,
      15
    ],
    "wide_address": "even128-bit word index, response {word[a+1],word[a]}; requests must remain within allocated bank",
    "strobe": "16 byte lanes per write; tensor tails zero; metadata padding zero",
    "read_backpressure": "engine must accept configured read responses without dropping them"
  },
  "descriptor_rules": {
    "profile": "one of profile_encodings and allowed by the chosen bank",
    "dimensions": "rows, cols interpreted by profile; profile-specific shape/byte extent checked before mutation",
    "position": "RoPE/attention logical position; unused profiles require0",
    "layer": "cache/static profiles layer0..29; unused profiles require0",
    "component": "B7:0 full initialization,1 RoPE-window update preserving static table,2 static-table update preserving RoPE window; other banks require0",
    "generation": "nonzero32-bit monotonically increasing within bank/component until coordinated reset; no wrap; no command may reconfigure a busy bank",
    "validity": "configuration invalidates only targeted component; never marks data/scale valid without successful covered writes"
  },
  "coverage": "Per16-byte block, 16-bit accepted-byte mask; require all bytes in configured data and padded scale extents. BF16 element writes and embedding scale lane metadata tracked. Invalid tails cannot satisfy missing valid bytes. Failed commands invalidate their targeted destination/component.",
  "output_tile_coverage": "BANK_CONFIG destination once per tensor. N-tile GEMM commands accumulate BF16 output coverage; do not reconfigure between its N tiles.",
  "DMA_scale_extent": "weight align16(ceil(Ntile/16)*4), K16 bytes, V48 bytes, A align16(ceil(rows/16)*4), Q/P align16(9*ceil(rows/16)*4), embedding rows*16",
  "logical_capacity_bytes": 2224928,
  "resource_claim": "logical allocation only; inferred/routed BRAM and URAM counts unverified",
  "descriptor_profile_shapes": {
    "hidden_projection_norm_residual_context": "rows1..32, cols576; BF16 data rows*576*2",
    "Q_BF16_Q_INT8": "rows1..32, cols576 (9*64); BF16 or INT8; Q8 scale align16(9*ceil(rows/16)*4)",
    "K_BF16_V_BF16": "rows1..32, cols192 (3*64); BF16",
    "gate_up_SiLU_BF16": "rows1..32, cols1536",
    "weight_INT8": "rows=Ntile1..192, cols=K576 or1536; scale align16(ceil(Ntile/16)*4)",
    "gamma_BF16": "rows1, cols576",
    "embedding_rows_INT8": "rows1..32, cols576; data rows*576, scale rows*16, two-bit descriptor lane per row",
    "K_V_cache_INT8": "rows=tokens1..1024, cols192, layer0..29; K16-byte padded scale, V48-byte scale",
    "score_probability": "rows1..32, cols=valid_context1..1024, position+rows<=cols; data rows*9*align16(cols)*element_bytes",
    "A_INT8": "rows1..32, cols576 or1536; scale align16(ceil(rows/16)*4)",
    "last_token_logits": "rows1, cols49152, BF16",
    "B7": "component0/1: rows1..32,cols64, position+rows<=1024; component2: rows30,cols64,position0; static scales always at4096..6015"
  },
  "coverage_metadata_note": "Coverage storage, descriptors and lane selectors are additional control resources, excluded from logical data-bank byte capacity. Module implementation may compress coverage if it proves identical readiness for partial/duplicate/gap writes."
}
