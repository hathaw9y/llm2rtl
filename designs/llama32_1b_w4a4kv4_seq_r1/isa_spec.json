  },
  "instruction_record": {
    "width_bits": 256,
    "command_bram_word_bits": 128,
    "words_per_instruction": 2,
    "field_layout_lsb_first": {
      "opcode": [0, 7],
      "flags": [8, 15],
      "tag": [16, 31],
      "src0_bank": [32, 39],
      "src1_bank": [40, 47],
      "dst_bank": [48, 55],
      "format": [56, 63],
      "arg0": [64, 95],
      "arg1": [96, 127],
      "arg2": [128, 159],
      "arg3": [160, 191],
      "arg4": [192, 223],
      "arg5": [224, 255]
    },
    "flag_bits": {
      "release_src0_on_success": 0,
      "release_src1_on_success": 1,
      "release_store_src_on_success": 2
    }
  },
  "command_transport": {
    "command_order_owner": "ps_software",
    "residency_tiling_owner": "ps_software",
    "recovery_policy_owner": "ps_software",
    "pl_dispatcher_role": "route_execute_report_only",
    "request_protocol": "ready_valid",
    "response_protocol": "ready_valid",
    "program_transport": "ps_preloaded_command_bram",
    "queue_policy": "no_ring_queue",
    "dispatch_policy": "strict_in_order_single_pc_scoreboard",
    "execution_policy": "execute_to_completion_before_next_fetch",
    "outstanding_command_limit": 1,
    "pc_advance_event": "executor_completion",
    "blocked_pc_policy": "stall_without_lookahead",
    "program_publish_order": ["instruction_records", "command_count", "start"],
    "mutation_while_busy": "forbidden"
  },
  "opcodes": [
    {
      "opcode": "DMA_LOAD",
      "encoding": 1,
      "module_id": "datamover_executor",
      "opcode_class": "dma_load",
      "operands": [
        {"name": "external_source", "kind": "external_ddr_address"},
        {"name": "destination", "kind": "local_bank_id"},
        {"name": "byte_count", "kind": "transfer_length"},
        {"name": "format", "kind": "format"},
        {"name": "tag", "kind": "tag"}
      ],
      "operand_semantics": "arg1:arg0 is the 64-bit DDR byte address; arg2 is byte_count; dst_bank names the complete destination bank",
      "completion_semantics": "destination transitions filling to ready only after a matching successful DMA response",
      "failure_semantics": "destination transitions to fault and is never committed ready"
    },
    {
      "opcode": "DMA_STORE",
      "encoding": 2,
      "module_id": "datamover_executor",
      "opcode_class": "dma_store",
      "operands": [
        {"name": "source", "kind": "local_bank_id"},
        {"name": "external_destination", "kind": "external_ddr_address"},
        {"name": "byte_count", "kind": "transfer_length"},
        {"name": "format", "kind": "format"},
        {"name": "tag", "kind": "tag"}
      ],
      "operand_semantics": "src0_bank is read; arg1:arg0 is the 64-bit DDR byte address; arg2 is byte_count",
      "completion_semantics": "source returns ready or becomes free when release_store_src_on_success is set",
      "failure_semantics": "source returns ready and dispatcher terminates the program with error"
    },
    {
      "opcode": "GEMM",
      "encoding": 16,
      "module_id": "gemm_executor",
      "opcode_class": "compute",
      "operands": [
        {"name": "a", "kind": "local_bank_id"},
        {"name": "b", "kind": "local_bank_id"},
        {"name": "c", "kind": "local_bank_id"},
        {"name": "m", "kind": "dimension"},
        {"name": "n", "kind": "dimension"},
        {"name": "k", "kind": "dimension"},
        {"name": "format", "kind": "format"},
        {"name": "tag", "kind": "tag"}
      ],
      "operand_semantics": "src0/src1 are complete local banks A/B, dst is C, and arg0/arg1/arg2 are M/N/K; GEMM owns internal tiling",
      "completion_semantics": "destination transitions compute_active to ready only after a matching successful GEMM response",
      "failure_semantics": "destination transitions to fault and is never committed ready"
    }
  ],
  "unresolved_decisions": []
}
