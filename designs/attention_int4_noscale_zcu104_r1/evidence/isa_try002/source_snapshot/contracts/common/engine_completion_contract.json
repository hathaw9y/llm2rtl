{
  "schema": "llm2rtl.common_contract.v1",
  "contract_id": "engine_completion",
  "version": 1,
  "scope": "Completion principle for new DMA and generated compute engines; existing revision evidence is unchanged.",
  "memory_read_response": "Each accepted read produces a memory resp_valid; the engine receives and processes all responses required by its accepted command.",
  "completion_rule": "engine_resp_valid_only_after_all_reads_received_and_processed_and_all_writes_accepted",
  "after_completion": "no_further_memory_requests_for_the_completed_command",
  "controller_rule": "matched_engine_completion_releases_tracked_roles_without_bank_read_pending",
  "release_rule": "retain_command_identity_until_matching_role_release_accepted",
  "error_rule": "error_completion_requires_memory_quiescence_otherwise_retain_ownership_until_coordinated_reset",
  "transport_rule": "exactly_one_completion_per_accepted_command_with_ready_valid_or_documented_pulse_capture",
  "verification_rule": "verify_last_memory_response_precedes_engine_completion_and_release"
}
