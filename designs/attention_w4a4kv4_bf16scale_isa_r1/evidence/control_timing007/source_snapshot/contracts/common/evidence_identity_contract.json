{
  "schema": "llm2rtl.common_contract.v1",
  "contract_id": "evidence_identity",
  "version": 1,
  "required_identity_fields": ["design_id", "revision", "source_sha256"],
  "module_evidence_fields": [
    "module_id",
    "contract_sha256",
    "source_manifest_sha256",
    "test_vector_sha256",
    "verification_report_sha256"
  ],
  "board_evidence_fields": [
    "build_id",
    "bit_sha256",
    "hwh_sha256",
    "manifest_sha256",
    "hardware_result_sha256"
  ],
  "rules": [
    "evidence_applies_only_to_the_recorded_revision_and_source_identity",
    "changed_source_or_contract_requires_affected_reverification",
    "simulation_synthesis_route_and_physical_board_results_are_distinct_claims",
    "previous_revision_pass_cannot_be_relabelled_as_current_revision_pass"
  ]
}
